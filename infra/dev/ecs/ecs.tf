# Service Connect namespace: lets the frontend reach the backend as http://backend:<port>
# inside the VPC, without the backend being exposed through the ALB.
resource "aws_service_discovery_http_namespace" "this" {
  name        = local.name
  description = "Service Connect namespace for ${local.name}"

  tags = {
    Env = var.env
  }
}

resource "aws_ecs_cluster" "this" {
  name = local.name

  setting {
    name  = "containerInsights"
    value = "disabled"
  }

  service_connect_defaults {
    namespace = aws_service_discovery_http_namespace.this.arn
  }

  tags = {
    Env = var.env
  }
}

resource "aws_ecs_cluster_capacity_providers" "this" {
  cluster_name       = aws_ecs_cluster.this.name
  capacity_providers = ["FARGATE", "FARGATE_SPOT"]
}

resource "aws_cloudwatch_log_group" "frontend" {
  name              = "/ecs/${local.name}/frontend"
  retention_in_days = var.log_retention_days

  tags = {
    Env = var.env
  }
}

resource "aws_cloudwatch_log_group" "backend" {
  name              = "/ecs/${local.name}/backend"
  retention_in_days = var.log_retention_days

  tags = {
    Env = var.env
  }
}

# ---------------------------------------------------------------------------
# Backend: Laravel API, internal only.
# SQLite sits on the task's ephemeral disk, so each new task migrates and reseeds,
# and the APP_KEY is regenerated by the entrypoint. Runs exactly one task.
# ---------------------------------------------------------------------------

resource "aws_ecs_task_definition" "backend" {
  family                   = "${local.name}-backend"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.backend.cpu
  memory                   = var.backend.memory
  execution_role_arn       = aws_iam_role.task_execution.arn

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = "X86_64"
  }

  container_definitions = jsonencode([
    {
      name      = "backend"
      image     = "${data.aws_ecr_repository.backend.repository_url}:${var.backend.image_tag}"
      essential = true

      portMappings = [
        {
          # Referenced by the service's Service Connect configuration.
          name          = "http"
          containerPort = var.backend.port
          protocol      = "tcp"
          appProtocol   = "http"
        },
      ]

      environment = [
        { name = "APP_URL", value = local.backend_url },
        { name = "APP_TIMEZONE", value = "Australia/Sydney" },
        { name = "LOG_LEVEL", value = "info" },
      ]

      # ECS ignores the Dockerfile HEALTHCHECK, so repeat it here.
      healthCheck = {
        command     = ["CMD-SHELL", "curl -fsS http://127.0.0.1:${var.backend.port}${var.backend.health_check_path} || exit 1"]
        interval    = 10
        timeout     = 3
        retries     = 5
        startPeriod = 30
      }

      logConfiguration = {
        logDriver = "awslogs"
        options = {
          awslogs-group         = aws_cloudwatch_log_group.backend.name
          awslogs-region        = var.region
          awslogs-stream-prefix = "backend"
        }
      }
    },
  ])

  tags = {
    Env = var.env
  }
}

resource "aws_ecs_service" "backend" {
  name            = "${local.name}-backend"
  cluster         = aws_ecs_cluster.this.id
  task_definition = aws_ecs_task_definition.backend.arn
  # SQLite is per task: more than one task would serve diverging data.
  desired_count = 1

  # Stop the old task before starting the new one, so there's never two copies.
  deployment_minimum_healthy_percent = 0
  deployment_maximum_percent         = 100

  capacity_provider_strategy {
    capacity_provider = local.capacity_provider
    weight            = 1
  }

  network_configuration {
    subnets          = local.task_subnet_ids
    security_groups  = [aws_security_group.backend.id]
    assign_public_ip = local.task_public_ip
  }

  # Registers the backend as http://backend:<port> for other services in the namespace.
  service_connect_configuration {
    enabled   = true
    namespace = aws_service_discovery_http_namespace.this.arn

    service {
      port_name      = "http"
      discovery_name = local.backend_dns_name

      client_alias {
        dns_name = local.backend_dns_name
        port     = var.backend.port
      }
    }

    log_configuration {
      log_driver = "awslogs"
      options = {
        awslogs-group         = aws_cloudwatch_log_group.backend.name
        awslogs-region        = var.region
        awslogs-stream-prefix = "service-connect"
      }
    }
  }

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  # GitHub Actions deploys new task definition revisions with each image release.
  lifecycle {
    ignore_changes = [task_definition]
  }

  depends_on = [aws_ecs_cluster_capacity_providers.this]

  tags = {
    Env = var.env
  }
}

# ---------------------------------------------------------------------------
# Frontend: Next.js, public behind the ALB. Calls the backend server-side.
# ---------------------------------------------------------------------------

resource "aws_ecs_task_definition" "frontend" {
  family                   = "${local.name}-frontend"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.frontend.cpu
  memory                   = var.frontend.memory
  execution_role_arn       = aws_iam_role.task_execution.arn

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = "X86_64"
  }

  container_definitions = jsonencode([
    {
      name      = "frontend"
      image     = "${data.aws_ecr_repository.frontend.repository_url}:${var.frontend.image_tag}"
      essential = true

      portMappings = [
        {
          name          = "http"
          containerPort = var.frontend.port
          protocol      = "tcp"
          appProtocol   = "http"
        },
      ]

      environment = [
        # Resolved by the Service Connect proxy in this task.
        { name = "API_URL", value = local.backend_url },
      ]

      logConfiguration = {
        logDriver = "awslogs"
        options = {
          awslogs-group         = aws_cloudwatch_log_group.frontend.name
          awslogs-region        = var.region
          awslogs-stream-prefix = "frontend"
        }
      }
    },
  ])

  tags = {
    Env = var.env
  }
}

resource "aws_ecs_service" "frontend" {
  name            = "${local.name}-frontend"
  cluster         = aws_ecs_cluster.this.id
  task_definition = aws_ecs_task_definition.frontend.arn
  desired_count   = var.frontend.desired_count

  capacity_provider_strategy {
    capacity_provider = local.capacity_provider
    weight            = 1
  }

  network_configuration {
    subnets          = local.task_subnet_ids
    security_groups  = [aws_security_group.frontend.id]
    assign_public_ip = local.task_public_ip
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.frontend.arn
    container_name   = "frontend"
    container_port   = var.frontend.port
  }

  # Client only: gets the proxy that resolves http://backend:<port>, registers nothing.
  service_connect_configuration {
    enabled   = true
    namespace = aws_service_discovery_http_namespace.this.arn

    log_configuration {
      log_driver = "awslogs"
      options = {
        awslogs-group         = aws_cloudwatch_log_group.frontend.name
        awslogs-region        = var.region
        awslogs-stream-prefix = "service-connect"
      }
    }
  }

  health_check_grace_period_seconds = 30

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  # GitHub Actions deploys new task definition revisions with each image release.
  # Terraform keeps managing the base task definition but doesn't roll the service back.
  lifecycle {
    ignore_changes = [task_definition]
  }

  depends_on = [
    aws_lb_listener.https,
    aws_ecs_cluster_capacity_providers.this,
    # The backend must be registered in the namespace before the frontend's proxy starts.
    aws_ecs_service.backend,
  ]

  tags = {
    Env = var.env
  }
}
